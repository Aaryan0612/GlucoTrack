rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if a user is one of the allowed family members
    function isFamilyMember(auth) {
      return auth != null && 
             (auth.token.email.lower() == 'aaryankuchekar06@gmail.com' || 
              auth.token.email.lower() == 'kuchekarnandini3@gmail.com');
    }

    // Shared family tracker collection
    match /users/shared_mom_tracker/{document=**} {
      allow read, write: if isFamilyMember(request.auth);
    }

    // User-scoped data security: users can only read/write their own subcollections
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
